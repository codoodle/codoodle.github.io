{
  "name": "codoodle.github.io",
  "version": "0.0.0",
  "author": {
    "name": "Yeongseok Yoon",
    "url": "https://codoodle.github.io"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.14.0",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ]
  },
  "scripts": {
    "typecheck": "pnpm -r --reverse run typecheck",
    "test": "vitest",
    "clean": "tsc --build tsconfig.build.json --clean",
    "build": "tsc --build tsconfig.build.json",
    "build:mdx": "pnpm -F @codoodle/www mdx",
    "build:www": "pnpm -F @codoodle/www build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@next/eslint-plugin-next": "^15.5.7",
    "@types/node": "24.3.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^3.2.4"
  }
}
