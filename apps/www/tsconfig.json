{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "rootDir": ".",
    "composite": false,
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowJs": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": ["node_modules"],
  "references": [
    { "path": "../../packages/codoodle-utils" },
    { "path": "../../packages/codoodle-mdx" }
  ]
}
